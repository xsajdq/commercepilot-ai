# Copy to .env and fill in real values for local development.
# Never commit the real .env file.

ENVIRONMENT=development

# --- Postgres ---
POSTGRES_USER=commercepilot
POSTGRES_PASSWORD=commercepilot
POSTGRES_DB=commercepilot
DATABASE_URL=postgresql+asyncpg://commercepilot:commercepilot@postgres:5432/commercepilot

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- AI providers (added Phase 7+) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Stripe (added Phase 20) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observability ---
SENTRY_DSN=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
